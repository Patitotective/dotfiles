[filechooser]
cmd=yazi-wrapper.sh
default_dir=$HOME
; Uncomment to skip creating destination save files with instructions in them
; create_help_file=0
env=TERMCMD=kitty
env=NVIM_CWD=abc
; the above line makes yazi not load the last project, the value of NVIM_CWD is irrelevant

; Mode must be one of 'suggested', 'default', or 'last'.
open_mode=suggested
save_mode=suggested
