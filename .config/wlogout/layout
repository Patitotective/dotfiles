{
    "label" : "lock",
    "action" : "sleep 0.2 && ~/scripts/hypr/lock.sh",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "~/scripts/hypr/hibernate.sh",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "~/scripts/hypr/logout.sh",
    "text" : "Exit",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "~/scripts/hypr/poweroff.sh",
    "text" : "Power off",
    "keybind" : "p"
}
{
    "label" : "suspend",
    "action" : "~/scripts/hypr/suspend.sh",
    "text" : "Suspend",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "~/scripts/hypr/reboot.sh",
    "text" : "Reboot",
    "keybind" : "r"
}

