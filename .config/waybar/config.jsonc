//   --// waybar config generated by wbarconfgen.sh //--   //
{
  // sourced from header module //
  "layer": "top",
  "output": [
    "*"
  ],
  "position": "top",
  "mod": "dock",
  "height": 28,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  // positions generated based on config.ctl //
  "modules-left": [
    "custom/padd",
    "custom/l_end",
    "cpu",
    "memory",
    "custom/r_end",
    //
    "custom/l_end",
    "clock",
    "custom/idle_inhibitor",
    "custom/r_end",
    //
    "custom/l_end",
    // "custom/keybindhint",
    "keyboard-state",
    "keyboard-state#num",
    "privacy",
    "custom/r_end",
    "custom/padd"
  ],
  "modules-center": [
    "custom/padd",
    "custom/l_end",
    "hyprland/workspaces",
    "hyprland/window",
    "custom/r_end",
    "custom/padd"
  ],
  "modules-right": [
    "custom/padd",
    "custom/l_end",
    "pulseaudio",
    "pulseaudio#microphone",
    "custom/r_end",
    //
    //
    "custom/l_end",
    "tray",
    "custom/r_end",
    //
    "custom/l_end",
    "battery",
    "custom/power",
    "custom/r_end",
    "custom/padd"
  ],
  // sourced from modules based on config.ctl //
  "cpu": {
    "interval": 10,
    "format": "󰍛 {usage}%",
    "rotate": 0,
    "format-alt": "{icon0}{icon1}{icon2}{icon3}",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "memory": {
    "states": {
      "c": 90, // critical
      "h": 60, // high
      "m": 30 // medium
    },
    "interval": 10,
    "format": "󰾆 {percentage}%",
    "rotate": 0,
    "format-m": "󰾅 {percentage}%",
    "format-h": "󰓅 {percentage}%",
    "format-c": " {percentage}%",
    "format-alt": "󰾆 {percentage}%",
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": "󰾆 {percentage}%\n {used:0.1f}GB/{total:0.1f}GB"
  },
  "clock": {
    "format": "󰥔 {:%R}",
    "rotate": 0,
    // "format": "{:%R 󰃭 %d·%m·%y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/idle_inhibitor": {
    "format": "{icon}",
    "rotate": 0,
    "format-icons": {
      "on": "󰅶 ",
      "off": "󰛊 "
    },
    "return-type": "json",
    "exec": "$HOME/scripts/hypr/checkIdle.sh",
    "on-click": "$HOME/scripts/hypr/toggleIdle.sh",
    "signal": 10,
    "tooltip": false
  },
  "hyprland/workspaces": {
    "rotate": 0,
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "persistent-workspaces": {},
    "signal": 30
  },
  "hyprland/window": {
    // "format": " {}",
    "format": "{}",
    "rotate": 0,
    "on-scroll-up": "hyprctl dispatch workspace -1; kill -SIGRTMIN+30 $(pgrep waybar)",
    "on-scroll-down": "hyprctl dispatch workspace +1; kill -SIGRTMIN+30 $(pgrep waybar)",
    "separate-outputs": true,
    // "rewrite": {
    //   // "cristobal@archlinux-nitro5:(.*)": "$1 ",
    //   // "(.*)(~.*)": "  $1 $2",
    //   // "(.*)(/.*)": "  $1 $2",
    //   // "(.*)": " ",
    //   "(~.*)": "  $1",
    //   "nvim(.*)": " $1",
    //   "yazi(.*)": "󰉋 $2",
    //   "y\\b(.*)": "󰉋 $2",
    //   "(.*)Ablaze Floorp": "󰖟 $1 Floorp",
    //   "(.*) — Ablaze Floorp": "󰖟 $1",
    //   "(.*) — Mozilla Firefox": "󰈹 $1",
    //   "(.*)Mozilla Firefox": "󰈹 $1 Firefox",
    //   "(.*) — Dolphin": "󰉋 $1",
    //   "(.*)Spotify": "󰓇 $1 Spotify",
    //   "(.*)Steam": "󰓓 $1 Steam",
    //   "(.*) - Discord": " $1",
    //   "(.*)Netflix": "󰝆 $1 Netflix",
    //   "(.*) — Google chrome": " $1",
    //   "(.*)Google chrome": " $1 Google chrome",
    //   "(.*) — Github": " $1",
    //   "(.*)Github": " $1 Github",
    //   "(.*)Spotify Free": "󰓇 $1 Spotify",
    //   "(.*)Spotify Premiun": "󰓇 $1 Spotify "
    // },
    "max-length": 50
  },
  "pulseaudio": {
    "format": "{icon}  {volume}",
    "rotate": 0,
    "format-muted": "婢",
    "on-click": "pavucontrol -t 3",
    // "on-click-right": "volumecontrol.sh -s ''",
    // "on-click-middle": "volumecontrol.sh -o m",
    "on-scroll-up": "~/scripts/hypr/setVolume.sh +1",
    "on-scroll-down": "~/scripts/hypr/setVolume.sh -1",
    "tooltip-format": "{icon}  {desc} // {volume}%",
    // "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "rotate": 0,
    "format-source": "",
    "format-source-muted": "",
    "on-click": "pavucontrol -t 4",
    // "on-click-middle": "volumecontrol.sh -i m",
    // "on-scroll-up": "volumecontrol.sh -i i",
    // "on-scroll-down": "volumecontrol.sh -i d",
    "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
    "scroll-step": 5
  },
  "custom/keybindhint": {
    "format": " ",
    "tooltip-format": " Keybinds",
    "rotate": 0,
    // "on-click": "keybinds_hint.sh"
  },
  "privacy": {
    "icon-size": 12,
    "icon-spacing": 5,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ]
  },
  "keyboard-state": {
    "capslock": true,
    // "device-path": "/dev/input/event8", // check yours with sudo libinput list-devices
    "binding-keys": [
      1
      // 58,
    ], // esc, capslock; find out the key codes with sudo libinput debug-events --show-keycodes
    "format": "{icon}",
    "format-icons": {
      "locked": "󰪛",
      "unlocked": "󰪛"
    }
  },
  "keyboard-state#num": {
    "numlock": true,
    // "device-path": "/dev/input/event8", // check yours with sudo libinput list-devices
    "binding-keys": [
      69
    ], // numlock; find out the key codes with sudo libinput debug-events --show-keycodes
    "format": "{icon}",
    "format-icons": {
      "locked": "󰎦",
      "unlocked": "󰎦"
    }
  },
  "tray": {
    "icon-size": 16,
    "rotate": 0,
    "spacing": 5
  },
  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "rotate": 0,
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "custom/power": {
    "format": "{}",
    "rotate": 0,
    // "exec": "echo ; echo  logout",
    "on-click": "~/scripts/hypr/powerMenu.sh",
    "tooltip": false
  },
  // modules for padding //
  "custom/l_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/r_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/sl_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/sr_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/rl_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/rr_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/padd": {
    "format": "  ",
    "interval": "once",
    "tooltip": false
  }
}
