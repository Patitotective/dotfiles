// check https://docs.gtk.org/Pango/pango_markup.html for available styling options
{
  "layer": "top",
  "output": [
    "*"
  ],
  "position": "top",
  "mod": "dock",
  "height": 28,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/padd",
    "custom/l_end",
    "cpu",
    "memory",
    "custom/r_end",
    //
    "custom/l_end",
    "clock",
    "custom/idle_inhibitor",
    "custom/r_end",
    //
    "custom/padd"
  ],
  "modules-center": [
    "custom/padd",
    "custom/l_end",
    "hyprland/workspaces",
    "hyprland/window",
    "custom/r_end",
    "custom/padd"
  ],
  "modules-right": [
    "custom/padd",
    "custom/l_end",
    "pulseaudio",
    "pulseaudio#microphone",
    // "custom/keybindhint",
    "custom/capslock",
    "custom/numlock",
    "custom/r_end",
    //
    "custom/l_end",
    "tray",
    "privacy",
    "custom/r_end",
    //
    "custom/l_end",
    "battery",
    "custom/power",
    "custom/r_end",
    "custom/padd"
  ],
  // sourced from modules based on config.ctl //
  "cpu": {
    "interval": 10,
    "format": "󰍛 {usage}%",
    "format-alt": "{icon0}{icon1}{icon2}{icon3}",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "memory": {
    "states": {
      "c": 90, // critical
      "h": 60, // high
      "m": 30 // medium
    },
    "interval": 10,
    "format": "󰾆 {percentage}%",
    "format-m": "󰾅 {percentage}%",
    "format-h": "󰓅 {percentage}%",
    "format-c": " {percentage}%",
    "format-alt": "󰾆 {percentage}%",
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": "󰾆 {percentage}%\n {used:0.1f}GB/{total:0.1f}GB"
  },
  "clock": {
    "format": "󰥔 {:%R}",
    // "format": "{:%R 󰃭 %d·%m·%y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "on": "󰅶 ",
      "off": "󰛊 "
    },
    "return-type": "json",
    "exec": "$HOME/scripts/hypr/checkIdle.sh",
    "on-click": "$HOME/scripts/hypr/toggleIdle.fish",
    "signal": 1,
    "tooltip": false
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    // "on-scroll-up": "hyprctl dispatch workspace -1",
    // "on-scroll-down": "hyprctl dispatch workspace +1",
    "signal": 2,
    // "show-special": true,
  },
  "hyprland/window": {
    "format": "  {title}",
    "on-scroll-up": "hyprctl dispatch workspace -1; kill -SIGRTMIN+2 $(pgrep waybar)",
    "on-scroll-down": "hyprctl dispatch workspace +1; kill -SIGRTMIN+2 $(pgrep waybar)",
    "separate-outputs": true,
    "rewrite": {
      "  [~/](.*)": " $1",
      "  nvim(.*)": " $1",
      "  yazi(.*)": "󰉋 $1",
      "  (((?!(YouTube|\\(.+\\) WhatsApp)).)*) — Ablaze Floorp": "󰖟 $1",
      "  (.*)YouTube — Ablaze Floorp": " $1",
      "  YouTube Music — Ablaze Floorp": " $1",
      "  \\(\\d+\\) WhatsApp(.*) — Ablaze Floorp": "󰖣 $1",
    },
    "max-length": 50
  },
  "pulseaudio": {
    "format": "{icon}   {volume}", // note there is an en space, a thinspace and a six-per-em space
    "format-muted": "󰖁   {volume}", // note there is an en space, a thinspace and a six-per-em space
    "on-click": "pavucontrol -t 3",
    "on-click-middle": "~/scripts/hypr/audiocontrol.fish toggle",
    "on-scroll-up": "~/scripts/hypr/audiocontrol.fish +0.01",
    "on-scroll-down": "~/scripts/hypr/audiocontrol.fish -0.01",
    "tooltip-format": "{icon}  {desc} // {volume}%",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}", // note there is an U+2002 : EN SPACE
    "format-source-muted": " {volume}", // note there is an U+2002 : EN SPACE
    "on-click": "pavucontrol -t 4",
    "on-click-middle": "~/scripts/hypr/miccontrol.fish toggle",
    "on-scroll-up": "~/scripts/hypr/miccontrol.fish +0.01",
    "on-scroll-down": "~/scripts/hypr/miccontrol.fish -0.01",
    "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
    "scroll-step": 5
  },
  "custom/keybindhint": {
    "format": " ",
    "tooltip-format": " Keybinds",
    // "on-click": "keybinds_hint.sh"
  },
  "privacy": {
    "icon-size": 12,
    "icon-spacing": 5,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ]
  },
  // TODO: toggle on click (there doesn't seem to be a good tool to do it, both wtype and ydotool seem abandoned and they don't work really well)
  "custom/capslock": {
    "exec": "$HOME/scripts/hypr/capslock.fish",
    "tooltip": false,
    "format": "{icon}",
    "format-icons": [
      "<span foreground='#f2f4f87f'>󰪛</span>", // locked
      "<span foreground='#f2f4f8ff'>󰪛</span>" // unlocked
    ],
    "signal": 3,
    "return-type": "json"
  },
  "custom/numlock": {
    "exec": "$HOME/scripts/hypr/numlock.fish",
    "tooltip": false,
    "format": "{icon}",
    "format-icons": [
      "<span foreground='#f2f4f87f'>󰎦</span>", // locked
      "<span foreground='#f2f4f8ff'>󰎦</span>" // unlocked
    ],
    "signal": 4,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 5
  },
  "battery": {
    "interval": 30,
    "states": {
      "good": 70,
      "warning": 30,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "custom/power": {
    "format": "",
    "on-click": "~/scripts/hypr/powerMenu.sh",
    "tooltip": false
  },
  // modules for padding //
  "custom/l_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/r_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/sl_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/sr_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/rl_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/rr_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/padd": {
    "format": "  ",
    "interval": "once",
    "tooltip": false
 }
}
