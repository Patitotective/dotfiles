// check https://docs.gtk.org/Pango/pango_markup.html for available styling options
{
  "layer": "top",
  "output": [
    "*"
  ],
  "position": "top",
  "mod": "dock",
  "height": 28,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/space",
    //
    "hyprland/submap",
    //
    "custom/start",
    "clock",
    "custom/idle_inhibitor",
    "custom/end",
    //
    "custom/start",
    "disk",
    "cpu",
    "memory",
    "temperature",
    "custom/end",
    //
    //
    "custom/space"
  ],
  "modules-center": [
    "custom/space",
    "custom/start",
    "hyprland/workspaces",
    "hyprland/window",
    "custom/end",
    "custom/space"
  ],
  "modules-right": [
    "custom/space",
    "custom/start",
    "backlight",
    "pulseaudio",
    "pulseaudio#microphone",
    // "custom/keybindhint",
    "custom/capslock",
    "custom/numlock",
    "custom/end",
    //
    "custom/start",
    "tray",
    "privacy",
    "custom/end",
    //
    "custom/start",
    "battery",
    "custom/power",
    "custom/end",
    "custom/space"
  ],
  // sourced from modules based on config.ctl //
  "cpu": {
    "interval": 10,
    "format": "󰍛  {usage}%", // in between there are two six-per-em space
    "format-alt": "{icon0}{icon1}{icon2}{icon3}",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "memory": {
    "states": {
      "c": 90, // critical
      "h": 60, // high
      "m": 30 // medium
    },
    "interval": 10,
    // in between the icons and the percentages there are two for-per-em spaces
    "format": "󰾆  {percentage}%",
    "format-m": "󰾅  {percentage}%",
    "format-h": "󰓅  {percentage}%",
    "format-c": "  {percentage}%",
    "format-alt": "󰾆  {percentage}%",
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": " {used:0.1f}GB/{total:0.1f}GB"
  },
  "temperature": {
    "critical-threshold": 80,
    "warning-threshold": 60,
    "format-critical": " {temperatureC}°C",
    "tooltip-format": "{temperatureF}°F\n{temperatureK} K",
    "format": "{icon} {temperatureC}°C", // in between there is a three-per-em space
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
    ]
  },
  "clock": {
    "format": "󰥔 {:%H:%M}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "on": "󰅶 ",
      "off": "󰛊 "
    },
    "return-type": "json",
    "exec": "$HOME/scripts/hypr/checkIdleInhibit.fish",
    "on-click": "$HOME/scripts/hypr/toggleIdleInhibit.fish",
    "signal": 1,
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "signal": 2,
    // "show-special": true,
  },
  "hyprland/window": {
    "format": "  {title}",
    "on-scroll-up": "hyprctl dispatch workspace -1; kill -SIGRTMIN+2 $(pgrep waybar)",
    "on-scroll-down": "hyprctl dispatch workspace +1; kill -SIGRTMIN+2 $(pgrep waybar)",
    "separate-outputs": true,
    "rewrite": {
      "  [~/](.*)": " $1",
      "  nvim(.*)": " $1",
      "  yazi(.*)": "󰉋 $1",
      "  (((?!(YouTube|\\(.+\\) WhatsApp|WhatsApp)).)*) — Ablaze Floorp": "󰖟 $1",
      "  Ablaze Floorp": "󰖟",
      "  (.*)YouTube — Ablaze Floorp": "  $1",
      "  YouTube Music — Ablaze Floorp": " $1",
      "  \\(\\d+\\) WhatsApp(.*) — Ablaze Floorp": "󰖣 $1",
      "  WhatsApp(.*) — Ablaze Floorp": "󰖣 $1",
    },
    "max-length": 70
  },
  "hyprland/submap": {
    "format": "<span text_transform='uppercase'>{}</span>",
    "on-click": "hyprctl dispatch submap reset",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%", // note there is an en space and a six-per-em space
    "format-muted": "󰖁  {volume}%", // note there is an en space and a six-per-em space
    "on-click": "pavucontrol -t 3",
    "on-click-middle": "~/scripts/hypr/audiocontrol.fish toggle",
    "on-scroll-up": "~/scripts/hypr/audiocontrol.fish +0.01",
    "on-scroll-down": "~/scripts/hypr/audiocontrol.fish -0.01",
    "tooltip-format": "{desc}",
    "format-icons": {
      // "headphone": "",
      // "headphones": "",
      // "speaker": "󰓃",
      // "hdmi": "󰡁",
      // "headset": "",
      // "hands-free": "󱡏",
      // "handsfree": "󱡏",
      // "portable": "󰄜",
      // "car": "",
      // "hifi": "󰓃",
      // "phone": "",
      "default": [
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    }
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%", // note there is a three-per-em space
    "format-source-muted": " {volume}%", // note there is an en space
    "on-click": "pavucontrol -t 4",
    "on-click-middle": "~/scripts/hypr/miccontrol.fish toggle",
    "on-scroll-up": "~/scripts/hypr/miccontrol.fish +0.01",
    "on-scroll-down": "~/scripts/hypr/miccontrol.fish -0.01",
    "tooltip-format": "{source_desc}",
    "scroll-step": 5
  },
  "custom/keybindhint": {
    "format": " ",
    "tooltip-format": " Keybinds",
    // "on-click": "keybinds_hint.sh"
  },
  "privacy": {
    "icon-size": 12,
    "icon-spacing": 5,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ]
  },
  // TODO: toggle on click (there doesn't seem to be a good tool to do it, both wtype and ydotool seem abandoned and they don't work really well)
  "custom/capslock": {
    "exec": "$HOME/scripts/hypr/capslock.fish",
    "format": "{icon}",
    "format-icons": [
      "<span foreground='#f2f4f87f'>󰪛</span>", // locked
      "<span foreground='#f2f4f8ff'>󰪛</span>" // unlocked
    ],
    "signal": 3,
    "return-type": "json"
  },
  "custom/numlock": {
    "exec": "$HOME/scripts/hypr/numlock.fish",
    "format": "{icon}",
    "format-icons": [
      "<span foreground='#f2f4f87f'>󰎦</span>", // locked
      "<span foreground='#f2f4f8ff'>󰎦</span>" // unlocked
    ],
    "signal": 4,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 5,
  },
  "battery": {
    "interval": 30,
    "states": {
      "good": 70,
      "warning": 30,
      "critical": 10
    },
    "format": "{icon} {capacity}%", // in between there is a three-per-em space
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "custom/power": {
    "format": "",
    "on-click": "~/scripts/hypr/powerMenu.sh",
    "tooltip-format": "Power menu"
  },
  // modules for spaceing //
  "custom/start": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/sl_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/sr_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/rl_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/rr_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/space": {
    "format": "  ",
    "interval": "once",
    "tooltip": false
  },
  "disk": {
    "interval": 30,
    "format": "  {percentage_used}%", // in between there is an en space and a six-per-em space
    "tooltip-format": "{used} used out of {total} available",
    "path": "/"
  },
  "backlight": {
    "device": "acpi_video1",
    "format": "{icon} {percent}%",
    "tooltip-format": "Monitor brightness",
    "format-icons": [
      "󰃞",
      "󰃝",
      "󰃠"
    ]
  }
  // "cava": {
  //   "cava_config": "$XDG_CONFIG_HOME/cava/config",
  //   "framerate": 30,
  //   "autosens": 1,
  //   "sensitivity": 100,
  //   "bars": 14,
  //   "lower_cutoff_freq": 50,
  //   "higher_cutoff_freq": 10000,
  //   "hide_on_silence": false,
  //   // "format_silent": "quiet",
  //   "method": "pulse",
  //   "source": "auto",
  //   "stereo": true,
  //   "reverse": false,
  //   "bar_delimiter": 0,
  //   "monstercat": false,
  //   "waves": false,
  //   "noise_reduction": 0.77,
  //   "input_delay": 2,
  //   "format-icons": [
  //     "▁",
  //     "▂",
  //     "▃",
  //     "▄",
  //     "▅",
  //     "▆",
  //     "▇",
  //     "█"
  //   ],
  //   "actions": {
}
}
