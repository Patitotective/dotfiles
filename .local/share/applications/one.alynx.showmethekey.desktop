[Desktop Entry]
Type=Application
Name=Show Me The Key
GenericName=Show Me The Key
Comment=Show keys you typed on screen.
Icon=one.alynx.showmethekey
Exec=/usr/bin/showmethekey-gtk --no-clickable --no-app-win
TryExec=/usr/bin/showmethekey-gtk
StartupNotify=false
Terminal=false
Categories=Utility;Accessibility;
