[user]
	email = cristobalriaga@gmail.com
	name = Cristobal
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
	tool = diffview
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "diffview"]
	cmd = nvim -n -c \"DiffviewOpen\" \"$MERGE\"
